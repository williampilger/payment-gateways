# =====================================================================
# payment-gateways — credenciais de SANDBOX para `npm run sandbox:<gateway>`
# Copie para .env e preencha. Variável em branco = gateway pulado.
# NUNCA use credenciais de produção aqui.
# =====================================================================

# --- Stripe (Dashboard > Developers > API keys, modo teste) ---
# Chave secreta de teste (sk_test_...)
STRIPE_SECRET_KEY=
# Segredo do endpoint de webhook (whsec_...) — `stripe listen` também mostra um
STRIPE_WEBHOOK_SECRET=

# --- Mercado Pago (Suas integrações > Credenciais de teste) ---
# Access Token de teste (TEST-... ou APP_USR-... do usuário de teste)
MP_ACCESS_TOKEN=
# "Assinatura secreta" da tela de Webhooks
MP_WEBHOOK_SECRET=

# --- PagBank / PagSeguro (token da conta sandbox) ---
PAGSEGURO_TOKEN=
# Opcional: o PagBank assina o webhook com o próprio token da conta (padrão = PAGSEGURO_TOKEN)
PAGSEGURO_WEBHOOK_TOKEN=

# --- Asaas (sandbox: Integrações > Chave de API) ---
# Chave de API ($aact_...)
ASAAS_API_KEY=
# Token de autenticação definido na configuração do webhook
ASAAS_WEBHOOK_TOKEN=

# --- Pagador usado nos testes ---
# CPF válido (pode ser gerado; PagBank e Asaas exigem)
SANDBOX_CUSTOMER_CPF=
# E-mail do pagador (Mercado Pago: NÃO pode ser o e-mail do vendedor)
SANDBOX_CUSTOMER_EMAIL=
